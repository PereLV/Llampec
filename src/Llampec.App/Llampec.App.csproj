<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType><WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RootNamespace>Llampec</RootNamespace><AssemblyName>Llampec</AssemblyName>
    <ApplicationIcon>Assets/Llampec.ico</ApplicationIcon><ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == 'win-arm64'">ARM64</PlatformTarget>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == 'win-x64'">x64</PlatformTarget>
    <SelfContained>false</SelfContained><PublishTrimmed>false</PublishTrimmed><PublishSingleFile>false</PublishSingleFile>
    <!-- Measured on ARM64 Release: ReadyToRun cut startup from 1.4 to 1.0 s and the first panel
         preparation from 207 to 165 ms. A tray app with a small heap needs neither the background
         GC thread nor dynamic PGO instrumentation. -->
    <PublishReadyToRun>true</PublishReadyToRun><TieredPGO>false</TieredPGO>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <!-- WinUI and Foundation only (with their Base, InteractiveExperiences and WebView2
         dependencies). The Microsoft.WindowsAppSDK metapackage also ships AI, ML, Search,
         Widgets and DWriteCore binaries that Llampec never loads: about 40 MB per build. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.6" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.9" />
    <ProjectReference Include="..\Llampec.Core\Llampec.Core.csproj" />
    <Using Include="System.Runtime.InteropServices" />
    <Content Include="Assets\Llampec.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../docs/third-party/Mouser.LICENSE.txt" Link="licenses/Mouser.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Windows App SDK's unpackaged publish path omits application PRI/XBF files.
       Include them in the publish manifest, not just in the build output.
       https://github.com/microsoft/WindowsAppSDK/issues/6720 -->
  <Target Name="IncludeWinUIResourcesInPublish" AfterTargets="ComputeFilesToPublish">
    <Error Condition="!Exists('$(OutDir)$(AssemblyName).pri')"
           Text="The application PRI is missing. Build WinUI resources before publishing." />
    <ItemGroup>
      <_LlampecXbf Include="$(OutDir)**\*.xbf" />
      <ResolvedFileToPublish Include="$(OutDir)$(AssemblyName).pri">
        <RelativePath>$(AssemblyName).pri</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="@(_LlampecXbf)">
        <RelativePath>%(_LlampecXbf.RecursiveDir)%(_LlampecXbf.Filename)%(_LlampecXbf.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
    <Error Condition="'@(_LlampecXbf)' == ''" Text="No compiled WinUI XAML was found for publication." />
  </Target>
</Project>
