<Window x:Class="Llampec.Flyout.FlyoutWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Llampec">
 <Grid x:Name="Stage" Background="Transparent" PointerPressed="OnStagePointerPressed" KeyDown="OnKeyDown">
 <Border x:Name="Surface" Margin="12" Background="Transparent" CornerRadius="8">
 <Grid>
 <!-- Elevation lives on a non-interactive layer. A Z translation on the
      interactive surface displaces WinUI hit testing from what is drawn,
      increasingly towards the panel's edges. -->
 <Border x:Name="ShadowCaster" CornerRadius="8" Translation="0,0,32" IsHitTestVisible="False">
  <Border.Shadow><ThemeShadow /></Border.Shadow>
 </Border>
 <SystemBackdropElement x:Name="PanelMaterial" CornerRadius="8" />
 <Grid x:Name="Root" BorderThickness="1" CornerRadius="8"
       BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}">
  <Grid.Resources>
   <Style x:Key="TileStatusStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
   </Style>
   <!-- Panel editor. ThemeResource follows Llampec's own theme, not the app default. -->
   <Style x:Key="EditorCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12" />
   </Style>
   <Style x:Key="EditorLiftedCardStyle" TargetType="Border" BasedOn="{StaticResource EditorCardStyle}">
    <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" />
   </Style>
   <Style x:Key="EditorTileLiftStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Margin" Value="-6" />
   </Style>
   <Style x:Key="EditorFaceStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource ControlElevationBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Height" Value="48" />
   </Style>
   <Style x:Key="EditorSlotStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
   </Style>
   <Style x:Key="EditorRemoveStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Margin" Value="-8,-8,0,0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="AllowFocusOnInteraction" Value="False" />
    <Setter Property="Background" Value="{ThemeResource ControlSolidFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
   </Style>
  </Grid.Resources>
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
  </Grid.RowDefinitions>
  <StackPanel Spacing="8">
  <Grid x:Name="PageHeader" ColumnSpacing="12" Margin="20,16,20,0" Visibility="Collapsed">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <Button x:Name="BackButton" Click="OnBack" Visibility="Collapsed" AutomationProperties.Name="Back" MinWidth="40" MinHeight="40">
    <FontIcon Glyph="&#xE72B;" FontFamily="Segoe Fluent Icons" FontSize="16" />
   </Button>
   <TextBlock x:Name="Heading" Grid.Column="1" Text="Llampec" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
  </Grid>
  <ContentControl x:Name="EditorHeaderHost" Margin="20,8,20,0" Visibility="Collapsed"
                  HorizontalContentAlignment="Stretch" />
  </StackPanel>
  <ScrollViewer x:Name="PanelScroll" Grid.Row="1" Padding="20"
                HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto" ZoomMode="Disabled">
   <StackPanel Spacing="12">
    <Grid x:Name="Tiles" ColumnSpacing="12" RowSpacing="16" />
    <StackPanel x:Name="Subpage" Spacing="8" Visibility="Collapsed" />
   </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="2">
   <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" Margin="24,0,24,12" />
   <Border BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
           Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" Padding="20,8" CornerRadius="0,0,7,7">
    <Grid>
     <TextBlock x:Name="FooterBrand" Text="Llampec" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
     <StackPanel x:Name="NormalFooterActions" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
     <Button x:Name="EditButton" Click="OnEdit" AutomationProperties.Name="Edit panel"
             Style="{StaticResource SubtleButtonStyle}" MinWidth="40" MinHeight="40">
      <FontIcon Glyph="&#xE70F;" FontFamily="Segoe Fluent Icons" FontSize="18" />
     </Button>
     <Button x:Name="MenuButton" Click="OnMenu" AutomationProperties.Name="Menu"
             Style="{StaticResource SubtleButtonStyle}" MinWidth="40" MinHeight="40">
      <FontIcon Glyph="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="20" />
     </Button>
     </StackPanel>
     <StackPanel x:Name="EditorActions" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Visibility="Collapsed">
      <Button x:Name="SaveEditorButton" Content="Save" Click="OnSaveEditor" Style="{StaticResource AccentButtonStyle}" MinWidth="0" MinHeight="40" Padding="6,5" />
      <Button x:Name="CancelEditorButton" Content="Cancel" Click="OnCancelEditor" MinWidth="0" MinHeight="40" Padding="6,5" />
     </StackPanel>
    </Grid>
   </Border>
  </StackPanel>
 </Grid>
 </Grid>
 </Border>
 </Grid>
</Window>
