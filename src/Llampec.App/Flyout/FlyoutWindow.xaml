<Window x:Class="Llampec.Flyout.FlyoutWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Llampec">
 <Grid x:Name="Stage" Background="Transparent" PointerPressed="OnStagePointerPressed" KeyDown="OnKeyDown">
 <Border x:Name="Surface" Margin="12" Background="Transparent" CornerRadius="8" Translation="0,0,32">
 <Border.Shadow><ThemeShadow /></Border.Shadow>
 <Grid>
 <SystemBackdropElement x:Name="PanelMaterial" CornerRadius="8" />
 <Grid x:Name="Root" BorderThickness="1" CornerRadius="8"
       BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}">
  <Grid.Resources>
   <Style x:Key="TileStatusStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
   </Style>
  </Grid.Resources>
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
  </Grid.RowDefinitions>
  <Grid x:Name="PageHeader" ColumnSpacing="12" Margin="20,16,20,0" Visibility="Collapsed">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <Button x:Name="BackButton" Click="OnBack" Visibility="Collapsed" AutomationProperties.Name="Back">
    <FontIcon Glyph="&#xE72B;" FontSize="16" />
   </Button>
   <TextBlock x:Name="Heading" Grid.Column="1" Text="Llampec" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
  </Grid>
  <ScrollViewer Grid.Row="1" Padding="20" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
   <StackPanel Spacing="12">
    <Grid x:Name="Tiles" ColumnSpacing="12" RowSpacing="16" />
    <StackPanel x:Name="Subpage" Spacing="8" Visibility="Collapsed" />
   </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="2">
   <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" Margin="24,0,24,12" />
   <Border BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
           Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" Padding="20,8" CornerRadius="0,0,7,7">
    <Grid>
     <TextBlock Text="Llampec" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
     <Button x:Name="MenuButton" HorizontalAlignment="Right" Click="OnMenu" AutomationProperties.Name="Menu"
             Style="{StaticResource SubtleButtonStyle}">
      <FontIcon Glyph="&#xE713;" FontSize="18" />
     </Button>
    </Grid>
   </Border>
  </StackPanel>
 </Grid>
 </Grid>
 </Border>
 </Grid>
</Window>
