<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">
  <!-- Windows 11 light palette (WinUI "Common" colour tokens). Only the ones Llampec uses. -->

  <SolidColorBrush x:Key="TextFillPrimaryBrush" Color="#E4000000" po:Freeze="True" />
  <SolidColorBrush x:Key="TextFillSecondaryBrush" Color="#9E000000" po:Freeze="True" />
  <SolidColorBrush x:Key="TextFillDisabledBrush" Color="#5C000000" po:Freeze="True" />
  <SolidColorBrush x:Key="TextOnAccentFillPrimaryBrush" Color="#FFFFFF" po:Freeze="True" />

  <SolidColorBrush x:Key="ControlFillDefaultBrush" Color="#F0FFFFFF" po:Freeze="True" />
  <SolidColorBrush x:Key="ControlFillSecondaryBrush" Color="#80F9F9F9" po:Freeze="True" />
  <SolidColorBrush x:Key="ControlFillTertiaryBrush" Color="#4DF9F9F9" po:Freeze="True" />
  <SolidColorBrush x:Key="ControlFillDisabledBrush" Color="#4DF9F9F9" po:Freeze="True" />

  <SolidColorBrush x:Key="TileHoverOverlayBrush" Color="#0F000000" po:Freeze="True" />
  <SolidColorBrush x:Key="TilePressedOverlayBrush" Color="#1F000000" po:Freeze="True" />

  <SolidColorBrush x:Key="ControlStrokeDefaultBrush" Color="#0F000000" po:Freeze="True" />
  <SolidColorBrush x:Key="ControlStrokeSecondaryBrush" Color="#29000000" po:Freeze="True" />
  <SolidColorBrush x:Key="DividerStrokeBrush" Color="#0F000000" po:Freeze="True" />
  <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="#66757575" po:Freeze="True" />

  <!-- The flyout's own surface: a plain opaque fill (no DWM backdrop) — see FlyoutWindow.ApplyBackdrop. -->
  <SolidColorBrush x:Key="SolidBackgroundFillBaseBrush" Color="#F3F3F3" po:Freeze="True" />
  <SolidColorBrush x:Key="LayerFillBrush" Color="#80FFFFFF" po:Freeze="True" />

  <SolidColorBrush x:Key="MenuFlyoutBackgroundBrush" Color="#F9F9F9" po:Freeze="True" />
  <SolidColorBrush x:Key="MenuFlyoutItemHoverBrush" Color="#09000000" po:Freeze="True" />

  <SolidColorBrush x:Key="AccentFillBrush" Color="#005FB8" po:Freeze="True" />
  <SolidColorBrush x:Key="AccentFillSecondaryBrush" Color="#E6005FB8" po:Freeze="True" />
  <SolidColorBrush x:Key="AccentFillTertiaryBrush" Color="#CC005FB8" po:Freeze="True" />
  <SolidColorBrush x:Key="AccentTextBrush" Color="#003E92" po:Freeze="True" />

</ResourceDictionary>
